# Docker Compose：复制为 docker-compose.yml 同目录下的 .env。
# 完整填写说明与分阶段示例：docs/environment-variables.md。
# 本文件可直接用于匿名服务；登录、管理员、API 与付费按需补齐。
# 修改后执行 docker compose up -d --force-recreate website；不要提交真实凭据。

# 一、站点与容器运行。SITE_URL 改为自己的正式 HTTPS 域名，不包含子路径。
SITE_URL=https://keep.video
DOWNVID_WEB_HOST=0.0.0.0
DOWNVID_WEB_PORT=6080
DOWNVID_DATA_DIR=/data/userdata
DOWNVID_DOWNLOADS=/data/downloads

# 二、存储。local 使用持久化卷；r2 时必须填写全部四项 R2_*。
STORAGE_DRIVER=local
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
FILE_TTL_HOURS=24
# 历史记录与文件分开保留；到期文件不因此延长访问。
DOWNLOAD_HISTORY_RETENTION_DAYS=90

# 三、全局资源与匿名额度。MB 参数按 MiB（1024×1024 字节）计算。
WEB_CONCURRENCY=3
WEB_OWNER_CONCURRENCY=2
WEB_MAX_QUEUED=30
WEB_SESSION_TASKS=10
WEB_PARSE_HOURLY_LIMIT=60
WEB_PARSE_DAILY_LIMIT=200
WEB_DOWNLOAD_DAILY_LIMIT=30
WEB_GENERATED_DAILY_MB=4096
WEB_DELIVERY_DAILY_MB=10240
MAX_FILE_MB=2048
TASK_TIMEOUT_MINUTES=60

# 四、统计。正式站点必须显式设为 production；关闭采集设 ANALYTICS_ENABLED=0。
ANALYTICS_ENABLED=1
ANALYTICS_ENVIRONMENT=production
ANALYTICS_RETENTION_DAYS=30
ANALYTICS_MAX_DAILY_MB=16

# 五、可选账户。三项一起留空时保留匿名下载；非本地启用登录必须为 HTTPS。
# 密钥至少 32 字符；Google Web 应用回调为 SITE_URL/api/auth/callback/google。
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 优先使用 /dashboard 展示的完整 u:… 标识；逗号分隔，空名单默认关闭。
ADMIN_USER_IDS=
API_BETA_USER_IDS=
# 仅首次引导使用；验证邮箱绑定稳定账户后，不自动转授给同邮箱的新主体。
ADMIN_EMAILS=
API_BETA_EMAILS=

# 六、免费账户与 Pro 额度。网页/API 共用滚动 24 小时额度；0 不是关闭方式。
ACCOUNT_PARSE_DAILY_LIMIT=500
ACCOUNT_DOWNLOAD_DAILY_LIMIT=100
PRO_PARSE_DAILY_LIMIT=2000
PRO_DOWNLOAD_DAILY_LIMIT=500
ACCOUNT_GENERATED_DAILY_MB=10240
PRO_GENERATED_DAILY_MB=51200
ACCOUNT_DELIVERY_DAILY_MB=20480
PRO_DELIVERY_DAILY_MB=102400

# 七、付费。下列三项一起留空或同时设置；启用前须已配置上面的 Google 登录。
# 价格必须是固定单价周期 Price；先用 Stripe 测试模式联调。
# Webhook 为 SITE_URL/api/billing/webhook；未配置时关闭购买入口。
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
